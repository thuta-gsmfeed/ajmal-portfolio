{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-hero-build/types/**/*.ts",
    ".next-horizontal-products/types/**/*.ts",
    ".next-journey-final/types/**/*.ts",
    ".next-light-journey/types/**/*.ts",
    ".next-partners-build/types/**/*.ts",
    ".next-philosophy-build/types/**/*.ts",
    ".next-philosophy-v2-build/types/**/*.ts",
    ".next-products-build/types/**/*.ts",
    ".next-transitions-build/types/**/*.ts",
    ".next-ventures-build/types/**/*.ts",
    ".next-yacht-brand-build/types/**/*.ts",
    ".next-yacht-build/types/**/*.ts",
    ".next-yacht-v2-build/types/**/*.ts",
    ".next-yacht-video-build/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-globe-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
